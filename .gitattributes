# Normalise line endings so the repo stays consistent across machines.
* text=auto eol=lf

# Windows-native files keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets — never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.mp4 binary
*.webm binary

# Vendored third-party code — excluded from language stats and diffs.
src/vendor/** linguist-vendored
