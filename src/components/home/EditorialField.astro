---
/**
 * SYSTEM B — Pretext-driven editorial text.
 *
 * Same progressive-enhancement contract as the wordmark: the real paragraph is
 * always present and is the accessible text. The island lays the same string
 * out line by line and hides the source. With no JS, CSS flows the paragraph
 * normally — which is a perfectly good result, and is exactly the baseline the
 * prototype has to beat to justify the dependency.
 */
type Props = { text: string };
const { text } = Astro.props;
---

<div class="field" data-editorial>
  <p class="field__source" data-editorial-source>{text}</p>
  <div
    class="field__stage"
    data-editorial-stage
    data-enhanced="pending"
    aria-hidden="true"
  >
  </div>
</div>
