---
/**
 * SYSTEM A — the wordmark.
 *
 * Renders a real, complete <h1> and an empty stage beside it. The island fills
 * the stage and demotes the heading to visually-hidden. If the island never
 * runs — no JS, no `Intl.Segmenter`, webfont never arrives — the heading is
 * the wordmark, styled by CSS to be the finished thing rather than a fallback.
 *
 * Styles live in `styles/home.css`, not here: the glyph elements are created
 * at runtime and would not receive Astro's scoped-style attribute.
 */
export interface Props {
  text: string;
  as?: 'h1' | 'p';
  /** Lets an enclosing landmark reference the heading with `aria-labelledby`. */
  headingId?: string;
}

const { text, as: Tag = 'h1', headingId } = Astro.props;
---

<div class="wordmark" data-wordmark={text}>
  <Tag class="wordmark__fallback" id={headingId} data-wordmark-fallback>{text}</Tag>
  <div
    class="wordmark__glyphs"
    data-wordmark-glyphs
    data-enhanced="pending"
    aria-hidden="true"
  >
  </div>
</div>
