---
/**
 * The transition experience between worlds. Two lines: the archival
 * classification of the section, then the act of entering it.
 *
 * Renders as static markup with no JavaScript. The entrance is CSS-only and
 * fail-safe (see styles/gate.css); the optional exit half is bound by
 * WorldLayout only when motion is allowed.
 *
 * `aria-hidden` because it is announcement, not content — every word it shows
 * is already the page's <h1> and its world label. A screen reader reading the
 * gate would repeat the page title twice before reaching anything new.
 */
import type { World } from '@lib/worlds';

type Props = { world: World };
const { world } = Astro.props;
---

<div class="gate" data-gate aria-hidden="true">
  <hr class="gate__rule" />
  <p class="gate__title">{world.gateTitle}</p>
  <p class="gate__enter">{world.gateEnter}</p>
</div>
